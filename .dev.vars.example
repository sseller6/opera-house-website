# Local development secrets. Copy this file to ".dev.vars" (it is git-ignored).
# In production, set these with `npx wrangler secret put NAME` or in the Cloudflare dashboard.

ADMIN_PASSWORD=change-me

# Leave the Square values blank and set DEMO_PAYMENTS=true to try checkout without Square.
DEMO_PAYMENTS=true
